# Server-side only. Never put real secrets in frontend files or commit them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_MS=30000
# Auth/profile SQLite. In production, use an absolute path on a persistent writable volume.
# DATABASE_PATH=/var/lib/sana-hub/sana-hub.sqlite
SESSION_TTL_MS=604800000
# Optional proxy-compatible endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1/responses
